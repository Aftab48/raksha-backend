PORT=3000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRE=8h
CORS_ORIGIN=http://localhost:5173

# Dashboard auth bypass:
# - true: allows dashboard and Android SOS ingest without JWT during development/demo
# - false: requires JWT for operator endpoints and JWT/X-API-Key for SOS ingest
DASHBOARD_DEV_MODE=true

# Optional shared key for SOS ingest endpoints (/dashboard/sos, /dashboard/alerts/:id/location)
SOS_INGEST_API_KEY=

# Optional operator station label shown in dashboard sessions when using dev bypass
DASHBOARD_DEFAULT_STATION=Central Station
